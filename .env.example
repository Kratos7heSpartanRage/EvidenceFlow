# EvidenceFlow Environment Configuration
# Never commit real credentials or secrets to git.

# Database
DATABASE_URL=sqlite:///./evidenceflow.db

# HTTP Client Settings
HTTP_TIMEOUT=20
IMPORT_CAP=500

# NCBI PubMed Credentials (Required by NCBI E-utilities usage policies)
NCBI_EMAIL=researcher@example.edu
NCBI_TOOL=evidenceflow
NCBI_API_KEY=

# Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
